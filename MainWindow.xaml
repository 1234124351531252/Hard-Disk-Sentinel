<Window x:Class="DiskSentinel.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="磁盘哨兵" Icon="Assets/DiskSentinel.ico" Height="850" Width="1320" MinHeight="720" MinWidth="1060" Background="#F5F7FB" FontFamily="Segoe UI, Microsoft YaHei UI" Closing="Window_Closing">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="#111C32"><DockPanel LastChildFill="True" Margin="22,28"><StackPanel DockPanel.Dock="Top"><StackPanel Orientation="Horizontal" Margin="0,0,0,40"><Border Width="36" Height="36" CornerRadius="11" Background="#476AF5"><TextBlock Text="◒" Foreground="White" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="磁盘哨兵" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="11,0"/></StackPanel><TextBlock Text="工作台" Foreground="#75829A" FontSize="11" Margin="5,0,0,12"/><Button x:Name="HomeNavButton" Content="⌂   首页" HorizontalContentAlignment="Left" Background="#263452" Foreground="White" Padding="14,13" Click="Home_Click"/><Button x:Name="ManageNavButton" Content="▤   磁盘管理" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#B8C2D5" Margin="0,6" Padding="14,13" Click="Manage_Click"/><Button x:Name="ModelNavButton" Content="✦   大模型接入" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#B8C2D5" Margin="0,0,0,6" Padding="14,13" Click="Model_Click"/><Button x:Name="DiskNavButton" Content="◫   磁盘空间" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#B8C2D5" Margin="0,6" Padding="14,13" Click="Disk_Click"/><Button x:Name="LogsNavButton" Content="↻   变化日志" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#B8C2D5" Margin="0,0,0,6" Padding="14,13" Click="Logs_Click"/></StackPanel><Border DockPanel.Dock="Bottom" Background="#1B2942" CornerRadius="12" Padding="13"><StackPanel><TextBlock Text="自动监控已开启" Foreground="White" FontWeight="SemiBold"/><TextBlock Text="所有可用本地磁盘" Foreground="#A9B5C9" FontSize="12" Margin="0,6,0,0"/><TextBlock x:Name="NavStatus" Text="等待首次扫描" Foreground="#A9B5C9" FontSize="11" Margin="0,8,0,0"/></StackPanel></Border></DockPanel></Border>
  <Grid Grid.Column="1" Margin="30,25,30,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel Grid.Row="0" Margin="0,0,0,18"><StackPanel><TextBlock x:Name="PageTitle" Text="首页" FontSize="27" FontWeight="Bold" Foreground="#17243A"/><TextBlock x:Name="PageSubtitle" Text="设备状态与实时运行数据" Foreground="#77849A" Margin="0,6,0,0"/></StackPanel><Button x:Name="ScanButton" DockPanel.Dock="Right" Content="⟳  立即扫描" VerticalAlignment="Center" Click="Scan_Click" Visibility="Collapsed"/></DockPanel>
   <UniformGrid x:Name="DiskSummaryCards" Grid.Row="1" Visibility="Collapsed" Columns="3" Margin="0,0,0,16"><Border Background="White" CornerRadius="14" Padding="16" Margin="0,0,12,0"><StackPanel><TextBlock Text="已用空间" Foreground="#77849A"/><TextBlock x:Name="UsedTotal" Text="—" FontSize="23" FontWeight="Bold" Foreground="#17243A" Margin="0,6,0,0"/></StackPanel></Border><Border Background="White" CornerRadius="14" Padding="16" Margin="0,0,12,0"><StackPanel><TextBlock Text="可用空间" Foreground="#77849A"/><TextBlock x:Name="FreeTotal" Text="—" FontSize="23" FontWeight="Bold" Foreground="#249B73" Margin="0,6,0,0"/></StackPanel></Border><Border Background="White" CornerRadius="14" Padding="16"><StackPanel><TextBlock Text="本次扫描变化" Foreground="#77849A"/><TextBlock x:Name="ChangeTotal" Text="等待扫描" FontSize="23" FontWeight="Bold" Foreground="#4468F5" Margin="0,6,0,0"/></StackPanel></Border></UniformGrid>
   <ScrollViewer x:Name="HomePage" Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel><UniformGrid Columns="4" Margin="0,0,0,14"><Border Background="White" CornerRadius="14" Padding="17" Margin="0,0,12,0"><StackPanel><TextBlock Text="主机名" Foreground="#77849A"/><TextBlock x:Name="HostValue" Text="—" FontSize="20" FontWeight="Bold" Foreground="#4468F5" Margin="0,8,0,0"/></StackPanel></Border><Border Background="White" CornerRadius="14" Padding="17" Margin="0,0,12,0"><StackPanel><TextBlock Text="当前时间" Foreground="#77849A"/><TextBlock x:Name="ClockValue" Text="—" FontSize="18" FontWeight="Bold" Foreground="#17243A" Margin="0,8,0,0"/></StackPanel></Border><Border Background="White" CornerRadius="14" Padding="17" Margin="0,0,12,0"><StackPanel><TextBlock Text="开机时长" Foreground="#77849A"/><TextBlock x:Name="UptimeValue" Text="—" FontSize="20" FontWeight="Bold" Foreground="#249B73" Margin="0,8,0,0"/></StackPanel></Border><Border Background="White" CornerRadius="14" Padding="17"><StackPanel><TextBlock Text="内网 IPv4" Foreground="#77849A"/><TextBlock x:Name="IpValue" Text="—" FontSize="20" FontWeight="Bold" Foreground="#249B73" Margin="0,8,0,0"/></StackPanel></Border></UniformGrid>
    <UniformGrid Columns="2"><Border Background="White" CornerRadius="14" Padding="18" Margin="0,0,14,14"><StackPanel><TextBlock Text="CPU" FontSize="16" FontWeight="Bold" Foreground="#17243A"/><DockPanel Margin="0,20,0,6"><TextBlock Text="处理器使用率" Foreground="#77849A"/><TextBlock x:Name="CpuValue" Text="读取中" DockPanel.Dock="Right" Foreground="#4468F5" FontWeight="Bold"/></DockPanel><ProgressBar x:Name="CpuBar" Height="9" Maximum="100" Value="0" Background="#E9EEF7" Foreground="#5271F5"/><TextBlock x:Name="CpuDetail" Text="系统总利用率" Foreground="#77849A" FontSize="11" Margin="0,8,0,0"/></StackPanel></Border>
     <Border Background="White" CornerRadius="14" Padding="18" Margin="0,0,0,14"><StackPanel><TextBlock Text="内存" FontSize="16" FontWeight="Bold" Foreground="#17243A"/><DockPanel Margin="0,20,0,6"><TextBlock Text="已用 / 总量" Foreground="#77849A"/><TextBlock x:Name="MemoryValue" Text="读取中" DockPanel.Dock="Right" Foreground="#4468F5" FontWeight="Bold"/></DockPanel><ProgressBar x:Name="MemoryBar" Height="9" Maximum="100" Value="0" Background="#E9EEF7" Foreground="#20A67A"/><TextBlock x:Name="MemoryDetail" Text="物理内存" Foreground="#77849A" FontSize="11" Margin="0,8,0,0"/></StackPanel></Border>
     <Border Background="White" CornerRadius="14" Padding="18" Margin="0,0,14,14"><StackPanel><TextBlock Text="磁盘" FontSize="16" FontWeight="Bold" Foreground="#17243A"/><DockPanel Margin="0,18,0,4"><TextBlock Text="已用空间" Foreground="#77849A"/><TextBlock x:Name="HomeDiskUsed" Text="—" DockPanel.Dock="Right" Foreground="#4468F5" FontWeight="Bold"/></DockPanel><DockPanel><TextBlock Text="可用空间" Foreground="#77849A"/><TextBlock x:Name="HomeDiskFree" Text="—" DockPanel.Dock="Right" Foreground="#249B73" FontWeight="Bold"/></DockPanel><TextBlock Text="所有可用本地磁盘合计" Foreground="#77849A" FontSize="11" Margin="0,8,0,0"/></StackPanel></Border>
     <Border Background="White" CornerRadius="14" Padding="18" Margin="0,0,0,14"><StackPanel><TextBlock Text="网络" FontSize="16" FontWeight="Bold" Foreground="#17243A"/><UniformGrid Columns="2" Margin="0,17,0,0"><StackPanel><TextBlock Text="上传速率" Foreground="#77849A"/><TextBlock x:Name="UploadValue" Text="—" FontSize="21" FontWeight="Bold" Foreground="#249B73" Margin="0,5,0,0"/><TextBlock Text="本次启动累计" Foreground="#77849A" FontSize="11" Margin="0,6,0,0"/><TextBlock x:Name="UploadTotal" Text="—" Foreground="#17243A"/></StackPanel><StackPanel><TextBlock Text="下载速率" Foreground="#77849A"/><TextBlock x:Name="DownloadValue" Text="—" FontSize="21" FontWeight="Bold" Foreground="#4468F5" Margin="0,5,0,0"/><TextBlock Text="本次启动累计" Foreground="#77849A" FontSize="11" Margin="0,6,0,0"/><TextBlock x:Name="DownloadTotal" Text="—" Foreground="#17243A"/></StackPanel></UniformGrid></StackPanel></Border></UniformGrid>
    <TextBlock x:Name="MetricsUpdated" Text="实时指标每秒更新" Foreground="#77849A" FontSize="11" Margin="2,2,0,8"/>
   </StackPanel></ScrollViewer>
   <Grid x:Name="DiskPage" Grid.Row="2" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="220"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="White" CornerRadius="14" Padding="10"><DataGrid x:Name="DriveGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None" Background="White" BorderThickness="0" RowHeight="48" SelectionUnit="FullRow" SelectionChanged="DriveGrid_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="磁盘" Binding="{Binding Name}" Width="1.2*"/><DataGridTextColumn Header="文件系统" Binding="{Binding Format}" Width="*"/><DataGridTextColumn Header="已用 / 总容量" Binding="{Binding UsageText}" Width="1.6*"/><DataGridTextColumn Header="可用空间" Binding="{Binding FreeText}" Width="*"/><DataGridTemplateColumn Header="使用率" Width="1.3*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Grid Width="90" Height="7" Margin="0,0,8,0"><Border Background="#EEF1F7" CornerRadius="4"/><Border Background="#5271F5" CornerRadius="4" HorizontalAlignment="Left" Width="{Binding BarWidth}"/></Grid><TextBlock Text="{Binding PercentText}" VerticalAlignment="Center"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Border>
    <Grid Grid.Row="1" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions><Border Background="White" CornerRadius="14" Padding="14" Margin="0,0,12,0"><DockPanel><StackPanel DockPanel.Dock="Top" Margin="0,0,0,10"><DockPanel><TextBlock Text="文件" FontWeight="Bold" FontSize="16" Foreground="#17243A"/><TextBlock x:Name="FolderSummary" DockPanel.Dock="Right" Foreground="#77849A" VerticalAlignment="Center"/></DockPanel><DockPanel Margin="0,8,0,0"><Button x:Name="UpButton" Content="↑ 上一级" Padding="9,5" Click="Up_Click"/><TextBlock x:Name="Breadcrumb" Text="此电脑" Margin="12,0" VerticalAlignment="Center" Foreground="#53627A"/></DockPanel></StackPanel><DataGrid x:Name="FilesGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None" Background="White" BorderThickness="0" RowHeight="34" MouseDoubleClick="FilesGrid_DoubleClick"><DataGrid.Columns><DataGridTemplateColumn Header="选" Width="42"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn IsReadOnly="True" Header="名称" Binding="{Binding Name}" Width="2.5*"/><DataGridTextColumn IsReadOnly="True" Header="类型" Binding="{Binding Type}" Width="1*"/><DataGridTextColumn IsReadOnly="True" Header="大小" Binding="{Binding SizeText}" Width="1*"/><DataGridTextColumn IsReadOnly="True" Header="修改时间" Binding="{Binding ModifiedText}" Width="1.4*"/></DataGrid.Columns></DataGrid></DockPanel></Border>
     <Border Grid.Column="1" Background="White" CornerRadius="14" Padding="16"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="空间分布" FontSize="16" FontWeight="Bold" Foreground="#17243A"/><TextBlock x:Name="PieSubtitle" Text="按根目录估算" Foreground="#77849A" FontSize="11" Margin="0,4,0,0"/></StackPanel><Canvas x:Name="DistributionChart" Width="190" Height="190" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10"/><ItemsControl x:Name="LegendList" VerticalAlignment="Bottom"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,3"><Ellipse Width="9" Height="9" Fill="{Binding Color}" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="{Binding Name}" Foreground="#53627A"/><TextBlock Text="{Binding SizeText}" DockPanel.Dock="Right" Foreground="#77849A"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></DockPanel></Border></Grid>
   </Grid>
   <Grid x:Name="ManagePage" Grid.Row="2" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,12"><StackPanel><TextBlock Text="文件管理" FontSize="18" FontWeight="Bold" Foreground="#17243A"/><DockPanel Margin="0,5,0,0"><ComboBox x:Name="ManageDrivePicker" Width="150" DisplayMemberPath="Name" SelectionChanged="ManageDrive_SelectionChanged"/><Button Content="↑ 上一级" Click="ManageUp_Click" Padding="9,5" Margin="8,0"/><TextBlock x:Name="ManagePath" Text="选择盘符浏览文件" Foreground="#77849A" VerticalAlignment="Center"/></DockPanel></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="AnalyzeButton" Content="AI 分析当前目录" Click="Analyze_Click" Margin="0,0,8,0"/><Button Content="删除所选" Background="#FDECEC" Foreground="#B42318" Click="Delete_Click"/></StackPanel></DockPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="2.3*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions><Border Background="White" CornerRadius="14" Padding="10" Margin="0,0,12,0"><DataGrid x:Name="ManageFilesGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" SelectionMode="Extended" HeadersVisibility="Column" GridLinesVisibility="None" Background="White" BorderThickness="0" RowHeight="34" MouseDoubleClick="ManageFiles_DoubleClick"><DataGrid.Columns><DataGridTemplateColumn Header="选" Width="42"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn IsReadOnly="True" Header="名称" Binding="{Binding Name}" Width="2.5*"/><DataGridTextColumn IsReadOnly="True" Header="类型" Binding="{Binding Type}" Width="1*"/><DataGridTextColumn IsReadOnly="True" Header="大小" Binding="{Binding SizeText}" Width="1*"/><DataGridTextColumn IsReadOnly="True" Header="修改时间" Binding="{Binding ModifiedText}" Width="1.4*"/><DataGridTextColumn IsReadOnly="True" Header="位置" Binding="{Binding FullPath}" Width="3*"/></DataGrid.Columns></DataGrid></Border><Border Grid.Column="1" Background="White" CornerRadius="14" Padding="16"><DockPanel><TextBlock Text="当前目录大小排行" FontWeight="Bold" FontSize="16" Foreground="#17243A" DockPanel.Dock="Top" Margin="0,0,0,12"/><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="RankingList"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,12"><DockPanel><TextBlock Text="{Binding RankName}" TextTrimming="CharacterEllipsis" Width="175" Foreground="#53627A"/><TextBlock Text="{Binding SizeText}" DockPanel.Dock="Right" Foreground="#17243A" FontWeight="SemiBold"/></DockPanel><Grid Height="7" Margin="0,5,0,0"><Border Background="#EEF1F7" CornerRadius="4"/><Border Background="#5271F5" HorizontalAlignment="Left" CornerRadius="4" Width="{Binding BarWidth}"/></Grid></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></DockPanel></Border></Grid>
    <Border Grid.Row="2" Background="White" CornerRadius="14" Padding="12" Margin="0,12,0,0"><DockPanel><StackPanel DockPanel.Dock="Top" Margin="0,0,0,8"><DockPanel><TextBlock Text="AI 预测结果" FontWeight="Bold" Foreground="#17243A"/><TextBlock x:Name="AnalysisStatus" Text="尚未分析" DockPanel.Dock="Right" Foreground="#77849A"/></DockPanel></StackPanel><DataGrid x:Name="AnalysisGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None" Background="White" BorderThickness="0"><DataGrid.Columns><DataGridTextColumn Header="文件" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="建议" Binding="{Binding Recommendation}" Width="1*"/><DataGridTextColumn Header="理由（AI推测）" Binding="{Binding Reason}" Width="4*"/><DataGridTextColumn Header="可信度" Binding="{Binding Confidence}" Width="1*"/></DataGrid.Columns></DataGrid></DockPanel></Border>
   </Grid>
   <Grid x:Name="ModelPage" Grid.Row="2" Visibility="Collapsed"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><Border Background="White" CornerRadius="14" Padding="22"><StackPanel><TextBlock Text="模型连接" FontSize="19" FontWeight="Bold" Foreground="#17243A"/><TextBlock Text="支持 Claude、Gemini 原生接口，以及 GPT、DeepSeek、Grok 和其他 OpenAI 兼容接口。密钥加密保存在本机。" Foreground="#77849A" Margin="0,5,0,18"/><TextBlock Text="服务商" Foreground="#53627A"/><ComboBox x:Name="ProviderInput" SelectedIndex="0" Padding="8" Margin="0,5,0,14" SelectionChanged="Provider_SelectionChanged"><ComboBoxItem Content="OpenAI 兼容 / 自定义"/><ComboBoxItem Content="GPT / OpenAI"/><ComboBoxItem Content="Claude"/><ComboBoxItem Content="Gemini"/><ComboBoxItem Content="DeepSeek"/><ComboBoxItem Content="Grok / xAI"/></ComboBox><TextBlock Text="API 地址" Foreground="#53627A"/><TextBox x:Name="EndpointInput" Text="https://api.openai.com/v1" Padding="10" Margin="0,5,0,14"/><TextBlock Text="模型名称" Foreground="#53627A"/><TextBox x:Name="ModelInput" Text="" Padding="10" Margin="0,5,0,14"/><TextBlock Text="API 密钥" Foreground="#53627A"/><PasswordBox x:Name="ApiKeyInput" Padding="10" Margin="0,5,0,14"/><StackPanel Orientation="Horizontal"><Button Content="保存连接" Click="SaveModel_Click" Margin="0,0,8,0"/><Button Content="测试连接" Click="TestModel_Click"/></StackPanel><TextBlock x:Name="ModelStatus" Text="未配置" Foreground="#77849A" Margin="0,12,0,0"/></StackPanel></Border><Border Background="#EEF3FC" CornerRadius="14" Padding="18" Margin="0,14,0,0"><StackPanel><TextBlock Text="文件分析的数据范围" FontWeight="Bold" Foreground="#17243A"/><TextBlock Text="分析前会显示发送确认。仅发送当前目录直接包含文件的路径、名称、扩展名、大小和修改时间；不读取或发送文件内容，也不递归子目录。AI 建议仅供参考，删除操作仍需在文件管理页单独确认。" TextWrapping="Wrap" Foreground="#61718A" Margin="0,8,0,0"/></StackPanel></Border></StackPanel></ScrollViewer></Grid>   <Border x:Name="LogsPage" Grid.Row="2" Background="White" CornerRadius="14" Padding="14" Visibility="Collapsed"><DataGrid x:Name="LogsGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None" Background="White" BorderThickness="0"><DataGrid.Columns><DataGridTextColumn Header="时间" Binding="{Binding TimeText}" Width="1.3*"/><DataGridTextColumn Header="变化" Binding="{Binding DeltaText}" Width="*"/><DataGridTextColumn Header="文件操作" Binding="{Binding Kind}" Width="1.2*"/><DataGridTextColumn Header="来源判断" Binding="{Binding Cause}" Width="2*"/><DataGridTextColumn Header="文件路径" Binding="{Binding Path}" Width="4*"/></DataGrid.Columns></DataGrid></Border>
  </Grid>
 </Grid>
</Window>

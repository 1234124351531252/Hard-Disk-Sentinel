<Window x:Class="DiskSentinel.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="磁盘哨兵" Icon="Assets/DiskSentinel.ico" Height="850" Width="1320" MinHeight="720" MinWidth="1060" Background="#F5F7FB" FontFamily="Segoe UI, Microsoft YaHei UI" Closing="Window_Closing">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="#111C32"><DockPanel LastChildFill="True" Margin="22,28"><StackPanel DockPanel.Dock="Top"><StackPanel Orientation="Horizontal" Margin="0,0,0,40"><Border Width="36" Height="36" CornerRadius="11" Background="#476AF5"><TextBlock Text="◒" Foreground="White" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="磁盘哨兵" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="11,0"/></StackPanel><TextBlock Text="工作台" Foreground="#75829A" FontSize="11" Margin="5,0,0,12"/><Button x:Name="HomeNavButton" Content="⌂   首页" HorizontalContentAlignment="Left" Background="#263452" Foreground="White" Padding="14,13" Click="Home_Click"/><Button x:Name="ManageNavButton" Content="▤   磁盘管理" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#B8C2D5" Margin="0,6" Padding="14,13" Click="Manage_Click"/><Button x:Name="ModelNavButton" Content="✦   大模型接入" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#B8C2D5" Margin="0,0,0,6" Padding="14,13" Click="Model_Click"/><Button x:Name="AIHistoryNavButton" Content="☷   模型记录" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#B8C2D5" Margin="0,0,0,6" Padding="14,13" Click="AIHistory_Click"/><Button x:Name="LogsNavButton" Content="↻   变化日志" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#B8C2D5" Margin="0,0,0,6" Padding="14,13" Click="Logs_Click"/><Button x:Name="SettingsNavButton" Content="⚙   设置" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#B8C2D5" Margin="0,0,0,6" Padding="14,13" Click="Settings_Click"/></StackPanel><Border DockPanel.Dock="Bottom" Background="#1B2942" CornerRadius="12" Padding="13"><StackPanel><TextBlock Text="自动监控已开启" Foreground="White" FontWeight="SemiBold"/><TextBlock Text="所有可用本地磁盘" Foreground="#A9B5C9" FontSize="12" Margin="0,6,0,0"/><TextBlock x:Name="NavStatus" Text="等待首次扫描" Foreground="#A9B5C9" FontSize="11" Margin="0,8,0,0"/></StackPanel></Border></DockPanel></Border>
  <Grid Grid.Column="1" Margin="24,18,24,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel Grid.Row="0" Margin="0,0,0,12"><StackPanel><TextBlock x:Name="PageTitle" Text="首页" FontSize="24" FontWeight="Bold" Foreground="#17243A"/><TextBlock x:Name="PageSubtitle" Text="磁盘空间总览与设备实时指标" Foreground="#77849A" Margin="0,6,0,0"/></StackPanel><Button x:Name="ScanButton" DockPanel.Dock="Right" Content="⟳  立即扫描" VerticalAlignment="Center" Click="Scan_Click" Visibility="Visible"/></DockPanel>
   <ScrollViewer x:Name="HomePage" Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="设备信息" FontSize="14" FontWeight="Bold" Foreground="#17243A" Margin="2,0,0,7"/><UniformGrid Columns="4" Margin="0,0,0,9"><Border Background="White" CornerRadius="11" Padding="10" Margin="0,0,8,0"><StackPanel><TextBlock Text="主机名" Foreground="#77849A"/><TextBlock x:Name="HostValue" Text="—" FontSize="16" FontWeight="Bold" Foreground="#4468F5" Margin="0,5,0,0"/></StackPanel></Border><Border Background="White" CornerRadius="11" Padding="10" Margin="0,0,8,0"><StackPanel><TextBlock Text="当前时间" Foreground="#77849A"/><TextBlock x:Name="ClockValue" Text="—" FontSize="14" FontWeight="Bold" Foreground="#17243A" Margin="0,5,0,0"/></StackPanel></Border><Border Background="White" CornerRadius="11" Padding="10" Margin="0,0,8,0"><StackPanel><TextBlock Text="开机时长" Foreground="#77849A"/><TextBlock x:Name="UptimeValue" Text="—" FontSize="16" FontWeight="Bold" Foreground="#249B73" Margin="0,5,0,0"/></StackPanel></Border><Border Background="White" CornerRadius="11" Padding="10"><StackPanel><TextBlock Text="内网 IPv4" Foreground="#77849A"/><TextBlock x:Name="IpValue" Text="—" FontSize="16" FontWeight="Bold" Foreground="#249B73" Margin="0,5,0,0"/></StackPanel></Border></UniformGrid>
    <TextBlock Text="实时指标" FontSize="14" FontWeight="Bold" Foreground="#17243A" Margin="2,0,0,7"/><UniformGrid Columns="2"><Border Background="White" CornerRadius="11" Padding="10" Margin="0,0,8,7"><StackPanel><TextBlock Text="CPU" FontSize="14" FontWeight="Bold" Foreground="#17243A"/><DockPanel Margin="0,8,0,3"><TextBlock Text="处理器使用率" Foreground="#77849A"/><TextBlock x:Name="CpuValue" Text="读取中" DockPanel.Dock="Right" Foreground="#4468F5" FontWeight="Bold"/></DockPanel><ProgressBar x:Name="CpuBar" Height="7" Maximum="100" Value="0" Background="#E9EEF7" Foreground="#5271F5"/><TextBlock x:Name="CpuDetail" Text="系统总利用率" Foreground="#77849A" FontSize="11" Margin="0,8,0,0"/></StackPanel></Border>
     <Border Background="White" CornerRadius="11" Padding="10" Margin="0,0,0,7"><StackPanel><TextBlock Text="内存" FontSize="14" FontWeight="Bold" Foreground="#17243A"/><DockPanel Margin="0,8,0,3"><TextBlock Text="已用 / 总量" Foreground="#77849A"/><TextBlock x:Name="MemoryValue" Text="读取中" DockPanel.Dock="Right" Foreground="#4468F5" FontWeight="Bold"/></DockPanel><ProgressBar x:Name="MemoryBar" Height="7" Maximum="100" Value="0" Background="#E9EEF7" Foreground="#20A67A"/><TextBlock x:Name="MemoryDetail" Text="物理内存" Foreground="#77849A" FontSize="11" Margin="0,8,0,0"/></StackPanel></Border></UniformGrid>
    <TextBlock x:Name="MetricsUpdated" Text="实时指标每秒更新" Foreground="#77849A" FontSize="11" Margin="2,0,0,5"/>
   <Grid x:Name="DiskOverview" Height="500" Margin="0,8,0,4"><Grid.RowDefinitions><RowDefinition Height="140"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="White" CornerRadius="14" Padding="10"><DataGrid x:Name="DriveGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None" Background="White" BorderThickness="0" RowHeight="30" SelectionUnit="FullRow" SelectionChanged="DriveGrid_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="磁盘" Binding="{Binding Name}" Width="1.2*"/><DataGridTextColumn Header="文件系统" Binding="{Binding Format}" Width="*"/><DataGridTextColumn Header="已用 / 总容量" Binding="{Binding UsageText}" Width="1.6*"/><DataGridTextColumn Header="可用空间" Binding="{Binding FreeText}" Width="*"/><DataGridTemplateColumn Header="使用率" Width="1.3*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Grid Width="90" Height="7" Margin="0,0,8,0"><Border Background="#EEF1F7" CornerRadius="4"/><Border Background="#5271F5" CornerRadius="4" HorizontalAlignment="Left" Width="{Binding BarWidth}"/></Grid><TextBlock Text="{Binding PercentText}" VerticalAlignment="Center"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Border>
    <Grid Grid.Row="1" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions><Border Background="White" CornerRadius="14" Padding="11" Margin="0,0,8,0"><DockPanel><StackPanel DockPanel.Dock="Top" Margin="0,0,0,10"><DockPanel><TextBlock Text="文件" FontWeight="Bold" FontSize="16" Foreground="#17243A"/><TextBlock x:Name="FolderSummary" DockPanel.Dock="Right" Foreground="#77849A" VerticalAlignment="Center"/></DockPanel><DockPanel Margin="0,8,0,0"><Button x:Name="UpButton" Content="↑ 上一级" Padding="9,5" Click="Up_Click"/><TextBlock x:Name="Breadcrumb" Text="此电脑" Margin="12,0" VerticalAlignment="Center" Foreground="#53627A"/></DockPanel></StackPanel><DataGrid x:Name="FilesGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None" Background="White" BorderThickness="0" RowHeight="26" MouseDoubleClick="FilesGrid_DoubleClick"><DataGrid.Columns><DataGridTemplateColumn Header="选" Width="42"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn IsReadOnly="True" Header="名称" Binding="{Binding Name}" Width="2.5*"/><DataGridTextColumn IsReadOnly="True" Header="类型" Binding="{Binding Type}" Width="1*"/><DataGridTextColumn IsReadOnly="True" Header="大小" Binding="{Binding SizeText}" Width="1*"/><DataGridTextColumn IsReadOnly="True" Header="修改时间" Binding="{Binding ModifiedText}" Width="1.4*"/></DataGrid.Columns></DataGrid></DockPanel></Border>
     <Border Grid.Column="1" Background="White" CornerRadius="14" Padding="16"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="空间分布" FontSize="14" FontWeight="Bold" Foreground="#17243A"/><TextBlock x:Name="PieSubtitle" Text="按根目录估算" Foreground="#77849A" FontSize="11" Margin="0,4,0,0"/></StackPanel><Canvas x:Name="DistributionChart" Width="190" Height="190" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10"/><ItemsControl x:Name="LegendList" VerticalAlignment="Bottom"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,3"><Ellipse Width="9" Height="9" Fill="{Binding Color}" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="{Binding Name}" Foreground="#53627A"/><TextBlock Text="{Binding SizeText}" DockPanel.Dock="Right" Foreground="#77849A"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></DockPanel></Border></Grid>


   </Grid>
   </StackPanel></ScrollViewer>
   <Grid x:Name="ManagePage" Grid.Row="1" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,12"><StackPanel><TextBlock Text="文件管理" FontSize="18" FontWeight="Bold" Foreground="#17243A"/><DockPanel Margin="0,5,0,0"><ComboBox x:Name="ManageDrivePicker" Width="150" DisplayMemberPath="Name" SelectionChanged="ManageDrive_SelectionChanged"/><Button Content="↑ 上一级" Click="ManageUp_Click" Padding="9,5" Margin="8,0"/><TextBlock x:Name="ManagePath" Text="选择盘符浏览文件" Foreground="#77849A" VerticalAlignment="Center"/></DockPanel></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="AnalyzeButton" Content="AI 分析当前目录" Click="Analyze_Click" Margin="0,0,8,0"/><Button Content="删除所选" Background="#FDECEC" Foreground="#B42318" Click="Delete_Click"/></StackPanel></DockPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="2.3*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions><Border Background="White" CornerRadius="14" Padding="10" Margin="0,0,12,0"><DataGrid x:Name="ManageFilesGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" SelectionMode="Extended" HeadersVisibility="Column" GridLinesVisibility="None" Background="White" BorderThickness="0" RowHeight="34" MouseDoubleClick="ManageFiles_DoubleClick"><DataGrid.Columns><DataGridTemplateColumn Header="选" Width="42"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn IsReadOnly="True" Header="名称" Binding="{Binding Name}" Width="2.5*"/><DataGridTextColumn IsReadOnly="True" Header="类型" Binding="{Binding Type}" Width="1*"/><DataGridTextColumn IsReadOnly="True" Header="大小" Binding="{Binding SizeText}" Width="1*"/><DataGridTextColumn IsReadOnly="True" Header="修改时间" Binding="{Binding ModifiedText}" Width="1.4*"/><DataGridTextColumn IsReadOnly="True" Header="位置" Binding="{Binding FullPath}" Width="3*"/></DataGrid.Columns></DataGrid></Border><Border Grid.Column="1" Background="White" CornerRadius="14" Padding="16"><DockPanel><TextBlock Text="当前目录大小排行" FontWeight="Bold" FontSize="16" Foreground="#17243A" DockPanel.Dock="Top" Margin="0,0,0,12"/><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="RankingList"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,12"><DockPanel><TextBlock Text="{Binding RankName}" TextTrimming="CharacterEllipsis" Width="175" Foreground="#53627A"/><TextBlock Text="{Binding SizeText}" DockPanel.Dock="Right" Foreground="#17243A" FontWeight="SemiBold"/></DockPanel><Grid Height="7" Margin="0,5,0,0"><Border Background="#EEF1F7" CornerRadius="4"/><Border Background="#5271F5" HorizontalAlignment="Left" CornerRadius="4" Width="{Binding BarWidth}"/></Grid></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></DockPanel></Border></Grid>
    <Border Grid.Row="2" Background="White" CornerRadius="14" Padding="12" Margin="0,12,0,0"><DockPanel><StackPanel DockPanel.Dock="Top" Margin="0,0,0,8"><DockPanel><TextBlock Text="AI 预测结果" FontWeight="Bold" Foreground="#17243A"/><TextBlock x:Name="AnalysisStatus" Text="尚未分析" DockPanel.Dock="Right" Foreground="#77849A"/></DockPanel></StackPanel><DataGrid x:Name="AnalysisGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None" Background="White" BorderThickness="0"><DataGrid.Columns><DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="类型" Binding="{Binding EntryType}" Width="*"/><DataGridTextColumn Header="用途推测" Binding="{Binding Kind}" Width="1.5*"/><DataGridTextColumn Header="建议" Binding="{Binding Recommendation}" Width="1.3*"/><DataGridTextColumn Header="理由（AI推测）" Binding="{Binding Reason}" Width="4*"/><DataGridTextColumn Header="可信度" Binding="{Binding Confidence}" Width="*"/></DataGrid.Columns></DataGrid></DockPanel></Border>
   </Grid>
   <Grid x:Name="ModelPage" Grid.Row="1" Visibility="Collapsed"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><Border Background="White" CornerRadius="14" Padding="22"><StackPanel><TextBlock Text="模型连接" FontSize="19" FontWeight="Bold" Foreground="#17243A"/><TextBlock Text="支持 Claude、Gemini 原生接口，以及 GPT、DeepSeek、Grok 和其他 OpenAI 兼容接口。密钥加密保存在本机。" Foreground="#77849A" Margin="0,5,0,18"/><TextBlock Text="服务商" Foreground="#53627A"/><ComboBox x:Name="ProviderInput" SelectedIndex="0" Padding="8" Margin="0,5,0,14" SelectionChanged="Provider_SelectionChanged"><ComboBoxItem Content="OpenAI 兼容 / 自定义"/><ComboBoxItem Content="GPT / OpenAI"/><ComboBoxItem Content="Claude"/><ComboBoxItem Content="Gemini"/><ComboBoxItem Content="DeepSeek"/><ComboBoxItem Content="Grok / xAI"/></ComboBox><TextBlock Text="API 地址" Foreground="#53627A"/><TextBox x:Name="EndpointInput" Text="https://api.openai.com/v1" Padding="10" Margin="0,5,0,14"/><TextBlock Text="模型名称" Foreground="#53627A"/><TextBox x:Name="ModelInput" Text="" Padding="10" Margin="0,5,0,14"/><TextBlock Text="API 密钥" Foreground="#53627A"/><PasswordBox x:Name="ApiKeyInput" Padding="10" Margin="0,5,0,14"/><StackPanel Orientation="Horizontal"><Button Content="保存连接" Click="SaveModel_Click" Margin="0,0,8,0"/><Button Content="测试连接" Click="TestModel_Click"/></StackPanel><TextBlock x:Name="ModelStatus" Text="未配置" Foreground="#77849A" Margin="0,12,0,0"/></StackPanel></Border><Border Background="#EEF3FC" CornerRadius="14" Padding="18" Margin="0,14,0,0"><StackPanel><TextBlock Text="文件分析的数据范围" FontWeight="Bold" Foreground="#17243A"/><TextBlock Text="分析前会显示发送确认。发送当前目录直属文件和文件夹的路径、名称、类型、大小和修改时间；文件夹仅作为单个条目，不发送其中内容，也不递归子目录。AI 建议仅供参考，删除操作仍需在文件管理页单独确认。" TextWrapping="Wrap" Foreground="#61718A" Margin="0,8,0,0"/></StackPanel></Border></StackPanel></ScrollViewer></Grid>   <Grid x:Name="AIHistoryPage" Grid.Row="1" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="1.2*"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,10"><TextBlock x:Name="AIHistorySummary" Text="共 0 次预测记录 · 仅本机保存" Foreground="#77849A" VerticalAlignment="Center"/><Button Content="清空记录" DockPanel.Dock="Right" Click="ClearAIHistory_Click"/></DockPanel><Border Grid.Row="1" Background="White" CornerRadius="14" Padding="10"><DataGrid x:Name="AIHistoryGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None" Background="White" BorderThickness="0" RowHeight="38" SelectionChanged="AIHistoryGrid_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="时间" Binding="{Binding TimeText}" Width="1.6*"/><DataGridTextColumn Header="服务商" Binding="{Binding Provider}" Width="1.2*"/><DataGridTextColumn Header="模型" Binding="{Binding Model}" Width="1.5*"/><DataGridTextColumn Header="输入 tokens" Binding="{Binding InputTokens}" Width="*"/><DataGridTextColumn Header="输出 tokens" Binding="{Binding OutputTokens}" Width="*"/><DataGridTextColumn Header="总计 tokens" Binding="{Binding TotalTokens}" Width="*"/></DataGrid.Columns></DataGrid></Border><Grid Grid.Row="2" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="White" CornerRadius="14" Padding="14" Margin="0,0,6,0"><DockPanel><TextBlock Text="发送给模型的内容" FontWeight="Bold" Foreground="#17243A" DockPanel.Dock="Top" Margin="0,0,0,8"/><TextBox x:Name="AIHistoryPrompt" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="0" Background="#F8FAFD" Foreground="#334155" Padding="10"/></DockPanel></Border><Border Grid.Column="1" Background="White" CornerRadius="14" Padding="14" Margin="6,0,0,0"><DockPanel><TextBlock Text="模型回复" FontWeight="Bold" Foreground="#17243A" DockPanel.Dock="Top" Margin="0,0,0,8"/><TextBox x:Name="AIHistoryResponse" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="0" Background="#F8FAFD" Foreground="#334155" Padding="10"/></DockPanel></Border></Grid></Grid>   <Grid x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><Border Background="White" CornerRadius="14" Padding="22"><StackPanel><TextBlock Text="存储位置" FontSize="19" FontWeight="Bold" Foreground="#17243A"/><TextBlock Text="分别设置扫描数据与日志的保存目录。更改后会把旧目录中尚未存在于目标位置的文件复制过去，不会覆盖目标目录已有文件。" TextWrapping="Wrap" Foreground="#77849A" Margin="0,5,0,18"/><TextBlock Text="应用数据目录" Foreground="#53627A"/><TextBlock Text="磁盘扫描基线、目录索引和加密保存的模型连接配置" Foreground="#77849A" FontSize="12" Margin="0,4,0,8"/><Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions><TextBox x:Name="SettingsDataPathInput" Grid.Column="0" VerticalContentAlignment="Center" Padding="10" Margin="0,0,10,0"/><Button Grid.Column="1" Content="浏览…" Click="BrowseDataPath_Click"/></Grid><TextBlock Text="日志目录" Foreground="#53627A"/><TextBlock Text="磁盘变化日志和模型请求/回复记录" Foreground="#77849A" FontSize="12" Margin="0,4,0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions><TextBox x:Name="SettingsLogPathInput" Grid.Column="0" VerticalContentAlignment="Center" Padding="10" Margin="0,0,10,0"/><Button Grid.Column="1" Content="浏览…" Click="BrowseLogPath_Click"/></Grid><StackPanel Orientation="Horizontal" Margin="0,18,0,0"><Button Content="保存设置" Click="SaveStorage_Click" Margin="0,0,10,0"/><Button Content="恢复默认" Click="ResetStorage_Click"/></StackPanel><TextBlock x:Name="SettingsStatus" Text="路径设置保存在本机用户配置中。" TextWrapping="Wrap" Foreground="#77849A" Margin="0,12,0,0"/></StackPanel></Border></StackPanel></ScrollViewer></Grid>   <Border x:Name="LogsPage" Grid.Row="1" Background="White" CornerRadius="14" Padding="14" Visibility="Collapsed"><DataGrid x:Name="LogsGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None" Background="White" BorderThickness="0"><DataGrid.Columns><DataGridTextColumn Header="时间" Binding="{Binding TimeText}" Width="1.3*"/><DataGridTextColumn Header="变化" Binding="{Binding DeltaText}" Width="*"/><DataGridTextColumn Header="文件操作" Binding="{Binding Kind}" Width="1.2*"/><DataGridTextColumn Header="来源判断" Binding="{Binding Cause}" Width="2*"/><DataGridTextColumn Header="文件路径" Binding="{Binding Path}" Width="4*"/></DataGrid.Columns></DataGrid></Border>
  </Grid>
 </Grid>
</Window>
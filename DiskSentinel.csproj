<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\DiskSentinel.ico</ApplicationIcon>
    <AssemblyName>磁盘哨兵</AssemblyName>
    <Product>磁盘哨兵 - 磁盘空间监控</Product>
  </PropertyGroup>
  <Target Name="GenerateDiskSentinelIcon" BeforeTargets="PrepareForBuild">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(ProjectDir)GenerateIcon.ps1&quot; -OutputPath &quot;$(ProjectDir)Assets\DiskSentinel.ico&quot;" />
  </Target>
  <ItemGroup>
    <Resource Include="Assets\DiskSentinel.ico" />
  </ItemGroup>
</Project>
